{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/equipment", "destination": "/equipments.html" },
    { "source": "/equipments", "destination": "/equipments.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
